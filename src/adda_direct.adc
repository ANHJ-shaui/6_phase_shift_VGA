# ============================================================================
#  VGA 640x480 4-4-4（第 6 周新增）
#  来源：《HX4S20 开发板手册》P16-P18，与 8_siggen 使用同一组引脚，
#        已核对与上面 AD807/DA902 的 J1 引脚无重叠。
#  RGB 位序按手册三组电阻阶梯（B=GAD0-3 / G=4-7 / R=8-11）推断；
#  上板若颜色不对，只需调整 vga_r/g/b 的 4 个引脚顺序，不影响逻辑。
# ============================================================================
set_pin_assignment	{ vga_hs }	{ LOCATION = E7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
